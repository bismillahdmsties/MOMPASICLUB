---
import type { NotionPost } from '../lib/notion';

export interface Props {
  post: NotionPost;
  featured?: boolean;
}

const { post, featured = false } = Astro.props;

const formattedDate = new Date(post.date).toLocaleDateString('id-ID', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});
---

<article
  class={`group flex flex-col bg-white dark:bg-zinc-900/90 rounded-3xl overflow-hidden border border-brand-100 dark:border-brand-900/60 shadow-soft-card hover:shadow-soft-pink transition-all duration-300 transform hover:-translate-y-1.5 ${
    featured ? 'md:grid md:grid-cols-12 md:gap-8 items-center p-4' : ''
  }`}
>
  <!-- Image Thumbnail Container -->
  <a
    href={`/blog/${post.slug}`}
    class={`relative overflow-hidden block ${
      featured ? 'md:col-span-7 h-72 md:h-96 rounded-2xl' : 'h-52 sm:h-60'
    }`}
  >
    <img
      src={post.coverImage}
      alt={`${post.title} - MOMPASICLUB`}
      loading="lazy"
      class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500 ease-out"
    />
    <div class="absolute inset-0 bg-gradient-to-t from-black/40 via-transparent to-transparent opacity-60"></div>
    
    <!-- First Tag Badge on Image -->
    {post.tags[0] && (
      <span class="absolute top-4 left-4 bg-white/90 dark:bg-zinc-900/90 backdrop-blur-md text-brand-600 dark:text-brand-300 text-xs font-bold px-3 py-1 rounded-full shadow-sm">
        {post.tags[0]}
      </span>
    )}
  </a>

  <!-- Content Container -->
  <div class={`flex flex-col justify-between flex-1 p-6 ${featured ? 'md:col-span-5 md:p-6' : ''}`}>
    <div>
      <!-- Meta Information (Date & Reading Time) -->
      <div class="flex items-center gap-3 text-xs text-gray-500 dark:text-gray-400 mb-3">
        <span class="flex items-center gap-1">
          <svg class="w-3.5 h-3.5 text-brand-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"></path>
          </svg>
          <time datetime={post.date}>{formattedDate}</time>
        </span>
        <span>•</span>
        <span class="flex items-center gap-1">
          <svg class="w-3.5 h-3.5 text-brand-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path>
          </svg>
          {post.readingTime}
        </span>
      </div>

      <!-- Title -->
      <h3 class={`font-display font-bold text-gray-900 dark:text-white group-hover:text-brand-600 dark:group-hover:text-brand-400 transition-colors line-clamp-2 ${
        featured ? 'text-2xl md:text-3xl mb-4' : 'text-lg md:text-xl mb-2.5'
      }`}>
        <a href={`/blog/${post.slug}`}>
          {post.title}
        </a>
      </h3>

      <!-- Excerpt -->
      <p class="text-sm text-gray-600 dark:text-gray-300 line-clamp-3 leading-relaxed mb-4">
        {post.excerpt}
      </p>
    </div>

    <!-- Card Footer (Author & Read Link) -->
    <div class="pt-4 border-t border-brand-50 dark:border-zinc-800 flex items-center justify-between">
      <div class="flex items-center gap-2">
        <div class="w-7 h-7 rounded-full bg-brand-100 dark:bg-brand-900/80 flex items-center justify-center text-xs font-bold text-brand-600 dark:text-brand-300">
          🌸
        </div>
        <span class="text-xs font-medium text-gray-700 dark:text-gray-300">
          {post.author}
        </span>
      </div>

      <a
        href={`/blog/${post.slug}`}
        class="inline-flex items-center gap-1 text-xs font-bold text-brand-600 dark:text-brand-400 group-hover:translate-x-1 transition-transform"
        aria-label={`Baca selengkapnya artikel ${post.title}`}
      >
        Baca Artikel
        <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
        </svg>
      </a>
    </div>
  </div>
</article>
