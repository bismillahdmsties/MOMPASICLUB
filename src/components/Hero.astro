---
---

<section class="relative overflow-hidden pt-8 pb-16 md:pt-16 md:pb-24 gradient-hero border-b border-brand-100 dark:border-brand-900/40">
  
  <!-- Decorative Background Blur Orbs -->
  <div class="absolute top-10 left-1/2 -translate-x-1/2 w-full max-w-7xl h-96 pointer-events-none overflow-hidden -z-10">
    <div class="absolute -top-20 left-10 w-72 h-72 bg-brand-200/50 dark:bg-brand-900/20 rounded-full blur-3xl"></div>
    <div class="absolute top-20 right-10 w-96 h-96 bg-rose-200/40 dark:bg-rose-950/20 rounded-full blur-3xl"></div>
  </div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-center">
      
      <!-- Left Column: Copywriting & CTAs -->
      <div class="lg:col-span-7 text-center lg:text-left space-y-6">
        
        <!-- Top Badge -->
        <div class="inline-flex items-center gap-2 px-4 py-2 rounded-full bg-white dark:bg-zinc-900 shadow-sm border border-brand-200 dark:border-brand-900">
          <span class="flex h-2 w-2 rounded-full bg-brand-500 animate-pulse"></span>
          <span class="text-xs font-bold tracking-wide uppercase text-brand-600 dark:text-brand-300">
            Panduan Ibu Newborn & Balita 1000 HPK
          </span>
        </div>

        <!-- H1 Utama SEO Friendly -->
        <h1 class="text-3xl sm:text-4xl lg:text-5xl xl:text-6xl font-display font-extrabold tracking-tight text-gray-900 dark:text-white leading-[1.15]">
          MOMPASICLUB: <span class="text-gradient-pink">Berikan Gizi Terbaik untuk Buah Hati dengan MPASI</span>
        </h1>

        <!-- Subheading dengan Keywords Target -->
        <p class="text-base sm:text-lg text-gray-600 dark:text-gray-300 max-w-2xl mx-auto lg:mx-0 leading-relaxed">
          Temukan <strong>pentingnya keseimbangan gizi untuk pertumbuhan anak di masa golden age</strong>. Dirancang khusus untuk ibu newborn agar proses pemberian makanan pendamping ASI menjadi mudah, menyenangkan, bernutrisi tinggi, dan anti GTM.
        </p>

        <!-- CTA Action Buttons -->
        <div class="flex flex-col sm:flex-row items-center justify-center lg:justify-start gap-4 pt-2">
          <a
            href="/blog"
            class="w-full sm:w-auto inline-flex items-center justify-center px-8 py-4 rounded-full font-bold text-base text-white bg-gradient-to-r from-brand-600 via-brand-500 to-rose-500 hover:from-brand-700 hover:to-rose-600 shadow-soft-pink hover:shadow-lg transition-all duration-300 transform hover:-translate-y-0.5"
          >
            <span>Jelajahi Resep & Panduan MPASI</span>
            <svg class="w-5 h-5 ml-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M14 5l7 7m0 0l-7 7m7-7H3"></path>
            </svg>
          </a>

          <a
            href="/panduan-gizi"
            class="w-full sm:w-auto inline-flex items-center justify-center px-7 py-4 rounded-full font-bold text-base text-gray-700 dark:text-gray-200 bg-white dark:bg-zinc-900 border border-brand-200 dark:border-brand-800 hover:bg-brand-50 dark:hover:bg-zinc-800 transition-all duration-200"
          >
            📋 Jadwal & Tekstur Usia Emas
          </a>
        </div>

        <!-- Social Proof & Badges -->
        <div class="pt-6 border-t border-brand-100 dark:border-brand-900/60 grid grid-cols-3 gap-4 text-center lg:text-left">
          <div>
            <div class="text-xl sm:text-2xl font-extrabold text-brand-600 dark:text-brand-400 font-display">100+</div>
            <div class="text-xs text-gray-500 dark:text-gray-400 font-medium">Menu Resep Teruji</div>
          </div>
          <div>
            <div class="text-xl sm:text-2xl font-extrabold text-brand-600 dark:text-brand-400 font-display">10.000+</div>
            <div class="text-xs text-gray-500 dark:text-gray-400 font-medium">Bunda Teredukasi</div>
          </div>
          <div>
            <div class="text-xl sm:text-2xl font-extrabold text-brand-600 dark:text-brand-400 font-display">100%</div>
            <div class="text-xs text-gray-500 dark:text-gray-400 font-medium">Bahan Alami Lokal</div>
          </div>
        </div>

      </div>

      <!-- Right Column: Visual Showcase -->
      <div class="lg:col-span-5 relative">
        <div class="relative mx-auto max-w-md lg:max-w-none">
          
          <!-- Main Hero Image Frame -->
          <div class="relative rounded-4xl p-2 bg-gradient-to-tr from-brand-300 via-rose-200 to-white dark:from-brand-900 dark:to-zinc-800 shadow-2xl">
            <img
              src="https://images.unsplash.com/photo-1596464716127-f2a82984de30?auto=format&fit=crop&w=1000&q=80"
              alt="Ibu Newborn Memberikan MPASI Bernutrisi Seimbang MOMPASICLUB"
              loading="eager"
              class="w-full h-80 sm:h-96 lg:h-[430px] object-cover rounded-[1.75rem]"
            />
          </div>

          <!-- Floating Card 1: Gizi 4 Bintang -->
          <div class="absolute -bottom-6 -left-4 sm:-left-6 bg-white/95 dark:bg-zinc-900/95 backdrop-blur-md p-4 rounded-2xl shadow-xl border border-brand-100 dark:border-brand-900 flex items-center gap-3 animate-bounce-subtle">
            <div class="w-11 h-11 rounded-xl bg-brand-100 dark:bg-brand-900/80 flex items-center justify-center text-xl">
              🥑
            </div>
            <div>
              <p class="text-xs font-bold text-gray-900 dark:text-white">Gizi 4 Bintang Lengkap</p>
              <p class="text-[11px] text-gray-500 dark:text-gray-400">Karbohidrat, Prohe, Lemak, Sayur</p>
            </div>
          </div>

          <!-- Floating Card 2: Anti GTM -->
          <div class="hidden sm:flex absolute -top-4 -right-4 bg-white/95 dark:bg-zinc-900/95 backdrop-blur-md p-3.5 rounded-2xl shadow-xl border border-brand-100 dark:border-brand-900 items-center gap-2.5">
            <span class="text-lg">🥣</span>
            <span class="text-xs font-bold text-brand-600 dark:text-brand-300">Resep Lezat Anti GTM</span>
          </div>

        </div>
      </div>

    </div>
  </div>
</section>
