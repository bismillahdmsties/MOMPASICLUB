---
import '../styles/global.css';
import SEO from '../components/SEO.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';

export interface Props {
  title?: string;
  description?: string;
  image?: string;
  canonical?: string;
  type?: 'website' | 'article';
  author?: string;
  publishDate?: string;
  modifiedDate?: string;
  tags?: string[];
  breadcrumbs?: { name: string; item: string }[];
}

const {
  title,
  description,
  image,
  canonical,
  type = 'website',
  author,
  publishDate,
  modifiedDate,
  tags,
  breadcrumbs,
} = Astro.props;
---

<!DOCTYPE html>
<html lang="id" class="scroll-smooth">
  <head>
    <SEO
      title={title}
      description={description}
      image={image}
      canonical={canonical}
      type={type}
      author={author}
      publishDate={publishDate}
      modifiedDate={modifiedDate}
      tags={tags}
      breadcrumbs={breadcrumbs}
    />
  </head>
  <body class="bg-white dark:bg-zinc-950 text-gray-900 dark:text-gray-100 flex flex-col min-h-screen antialiased">
    <Navbar />
    <main class="flex-grow">
      <slot />
    </main>
    <Footer />
  </body>
</html>
