---
import Layout from '../layouts/Layout.astro';
---

<Layout
  title="Halaman Tidak Ditemukan (404) | TEMAN BUNDA"
  description="Halaman yang Bunda cari tidak ditemukan. Kembali ke beranda untuk melihat artikel dan panduan MPASI lainnya."
>
  <div class="max-w-2xl mx-auto px-4 py-24 text-center space-y-6">
    <div class="w-24 h-24 mx-auto rounded-3xl bg-brand-100 dark:bg-brand-900/60 flex items-center justify-center text-4xl shadow-soft-pink">
      🥣
    </div>
    <h1 class="text-4xl sm:text-5xl font-display font-extrabold text-gray-900 dark:text-white">
      404 - Halaman Tidak Ditemukan
    </h1>
    <p class="text-base text-gray-600 dark:text-gray-300">
      Sepertinya resep atau panduan yang Bunda cari telah dipindahkan atau belum tersedia.
    </p>
    <div>
      <a
        href="/"
        class="inline-flex items-center justify-center px-8 py-3.5 rounded-full font-bold text-sm bg-brand-500 text-white shadow-soft-pink hover:bg-brand-600 transition-all"
      >
        Kembali ke Beranda 🏠
      </a>
    </div>
  </div>
</Layout>
