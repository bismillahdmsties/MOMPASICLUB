# Notion API Configuration
# Dapatkan Token Integrasi Internal di: https://www.notion.so/my-integrations
NOTION_TOKEN=secret_your_notion_integration_token_here

# Dapatkan Database ID dari URL database Notion Anda (32 karakter setelah workspace/)
# Contoh: https://www.notion.so/username/a8aec43384f447ed84390e8e42c2e089?v=... -> Database ID adalah: a8aec43384f447ed84390e8e42c2e089
NOTION_DATABASE_ID=your_32_character_database_id_here
